{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "warn"
  },
  "ignorePatterns": [
    "dist",
    "public",
    ".vercel",
    ".sst",
    ".astro",
    "**/*.astro"
  ]
}
