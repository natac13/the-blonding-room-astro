---
import '../styles/global.css'
import type { ImageMetadata } from 'astro'
import { Font, getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import Schema from '../components/Schema.astro'
import BookingStrip from '../components/BookingStrip.astro'
import heroImage from '../assets/gallery-2/staff/group-0.jpg'

interface Props {
  title?: string
  description?: string
  /** Share-preview image; defaults to the hero team photo. */
  image?: ImageMetadata
  imageAlt?: string
  author?: string
}

const {
  title,
  description: descriptionProp,
  image: imageProp,
  imageAlt: imageAltProp,
  author,
} = Astro.props

const url = new URL(Astro.url.pathname, Astro.site)
const siteTitle = 'The Blonding Room'
const finalTitle = title ? `${title} | ${siteTitle}` : siteTitle
const description =
  descriptionProp ||
  'The Blonding Room is a hair salon near London, Ontario specializing in blonding, balayage, colouring and styling services. Located in Arva, minutes from Masonville Mall.'

// Share cards render at 1.91:1, so the landscape hero is cropped to that shape.
// Portrait images are only resized, letting each platform choose its own crop.
const shareImage = await getImage(
  imageProp
    ? { src: imageProp, width: 600, format: 'jpeg' }
    : { src: heroImage, width: 1024, height: 536, fit: 'cover', format: 'jpeg' },
)
const image = new URL(shareImage.src, Astro.site)
const imageAlt = imageAltProp || 'The Blonding Room team in the salon'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- SEO -->

    <meta property="og:site_name" content={siteTitle} />

    <meta property="og:type" content="website" />
    <link rel="canonical" href={url} />
    <meta property="og:url" content={url} />
    <meta name="apple-mobile-web-app-title" content={siteTitle} />

    <title>{finalTitle}</title>
    <meta property="og:title" content={finalTitle} />
    <meta name="twitter:title" content={finalTitle} />

    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta name="twitter:description" content={description} />

    <meta property="og:image" content={image} />
    <meta name="twitter:image" content={image} />
    <meta property="og:image:width" content={String(shareImage.attributes.width)} />
    <meta property="og:image:height" content={String(shareImage.attributes.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--  -->
    <meta
      name="google-site-verification"
      content="IiuNSYoLsSXXeEp3zOeZO21AgHB4jq6GAprOc_6lnlw"
    />

    {author && <meta name="author" content={author} />}

    <!-- <meta name="copyright" content="ISC" /> -->

    <!--  -->

    <!-- Geo -->
    <meta name="geo.region" content="CA-ON" />
    <meta name="geo.placename" content="Arva, Ontario" />
    <meta name="geo.position" content="43.0505;-81.2949" />
    <meta name="ICBM" content="43.0505, -81.2949" />

    <!-- <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" /> -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- /SEO -->
    <Schema />
    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-parisienne" preload />
    <ClientRouter />
    <!-- Marks JS as available so JS-only start states (e.g. [data-animate]) never
         hide content without JS. ClientRouter replaces <html> attributes on each
         navigation, so the class is re-applied after every swap. -->
    <script is:inline>
      document.documentElement.classList.add('js')
      document.addEventListener('astro:after-swap', () =>
        document.documentElement.classList.add('js'),
      )
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-gray-900 pb-[calc(3rem+1px+env(safe-area-inset-bottom))] font-sans font-light lg:pb-0"
  >
    <Navbar />
    <main class="grow">
      <slot />
    </main>
    <Footer />
    <BookingStrip />
  </body>
</html>
