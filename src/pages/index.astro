---
import AboutUs from '../components/AboutUs.astro'
import Contact from '../components/Contact.astro'
import HairServices from '../components/HairServices.astro'
import Hero from '../components/Hero.astro'
import SalonGallery from '../components/SalonGallery.astro'
import StaffCards from '../components/StaffCards.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Hair Salon Near London, Ontario — Blonding, Balayage & Colour">
  <Hero />
  <div data-animate><SalonGallery /></div>
  <div data-animate><HairServices /></div>
  <div data-animate><AboutUs /></div>
  <div data-animate><StaffCards /></div>
  <div data-animate><Contact /></div>
</Layout>

<style>
  /* Hidden start state only when JS can reveal it (html.js, set in Layout)
     and the user has not asked for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-animate]:not(.is-visible) {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    [data-animate] {
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
    }
  }
</style>

<script>
  function initAnimations() {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        }
      },
      { threshold: 0.1 },
    )

    document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el))
  }

  document.addEventListener('astro:page-load', initAnimations)
</script>
