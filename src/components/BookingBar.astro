---
import { Icon } from 'astro-icon/components'
import { booking } from '~/data/booking'

// Mobile-only persistent booking affordance. Both prototype variants render;
// `html[data-booking]` (set in Layout) picks which one shows. See global.css.
---

<!-- Variant A: full-width bottom bar, Call and Text halves -->
<nav
  aria-label="Book an appointment"
  class="proto-bar fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-primary-500/40 bg-gray-950/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden"
>
  <a
    href={booking.telHref}
    class="flex h-14 items-center justify-center gap-2 bg-primary-600 text-xs font-medium uppercase tracking-[0.2em] text-black active:bg-primary-500"
  >
    <Icon name="lucide:phone" class="h-4 w-4" aria-hidden="true" />
    Call to book
  </a>
  <a
    href={booking.smsHref}
    class="flex h-14 items-center justify-center gap-2 text-xs font-medium uppercase tracking-[0.2em] text-primary-300 active:bg-gray-900"
  >
    <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
    Text to book
  </a>
</nav>

<!-- Variant B: floating pill that expands into Call / Text + hours -->
<details
  class="proto-pill group fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-40 md:hidden"
>
  <summary
    class="ml-auto flex h-12 w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-primary-500 bg-gray-950/90 px-5 text-xs font-medium uppercase tracking-[0.2em] text-primary-300 shadow-lg shadow-black/50 backdrop-blur-md [&::-webkit-details-marker]:hidden"
  >
    <Icon name="lucide:phone" class="h-4 w-4 group-open:hidden" aria-hidden="true" />
    <Icon name="lucide:x" class="hidden h-4 w-4 group-open:block" aria-hidden="true" />
    <span class="group-open:hidden">Book</span>
    <span class="hidden group-open:inline">Close</span>
  </summary>
  <div
    class="absolute right-0 bottom-full mb-3 w-64 rounded-sm border border-primary-500/40 bg-gray-950/95 p-4 shadow-xl shadow-black/60 backdrop-blur-md"
  >
    <p class="font-cursive text-2xl text-white">Book by phone</p>
    <p class="mt-1 text-xs text-gray-400">{booking.hours}</p>
    <div class="mt-4 flex flex-col gap-2">
      <a
        href={booking.telHref}
        class="flex h-12 items-center justify-center gap-2 bg-primary-600 text-xs font-medium uppercase tracking-[0.2em] text-black"
      >
        <Icon name="lucide:phone" class="h-4 w-4" aria-hidden="true" />
        Call
      </a>
      <a
        href={booking.smsHref}
        class="flex h-12 items-center justify-center gap-2 border border-primary-500/60 text-xs font-medium uppercase tracking-[0.2em] text-primary-300"
      >
        <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
        Text
      </a>
    </div>
    <p class="mt-3 text-center text-sm text-gray-300">{booking.phoneDisplay}</p>
  </div>
</details>
